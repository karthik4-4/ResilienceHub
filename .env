# Groq API Configuration
GROQ_API_KEY=
GROQ_MODEL_REASONING=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Execution & Mode Settings (Set to 'live' when GROQ_API_KEY is provided, or 'offline' for local deterministic mock/eval)
SCDRC_MODE=offline
SCDRC_LOG_LEVEL=INFO
SCDRC_DATABASE_URL=sqlite:///./data/scdrc.db
SCDRC_CHROMA_PERSIST_DIR=./data/chroma_db
SCDRC_OUTPUTS_DIR=./outputs
